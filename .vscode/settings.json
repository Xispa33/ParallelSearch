{
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "files.associations": {
        "iostream": "cpp",
        "filesystem": "cpp",
        "vector": "cpp",
        "string": "cpp",
        "iosfwd": "cpp",
        "iterator": "cpp",
        "map": "cpp"
    },
    "cmake.environment": {"WORKSPACE_DIR":"${workspaceFolder}",
        "BUILD_DIR":"${workspaceFolder}/build",
        "SEARCH_ENGINE_DIR":"${workspaceFolder}/search_engine",
        "ENGINE_DIR":"${workspaceFolder}/search_engine/engine",
        "ENGINE_SRC_DIR":"${workspaceFolder}/search_engine/engine/src",
        "ENGINE_INC_DIR":"${workspaceFolder}/search_engine/engine/inc",
        "WORDS_LIST_DIR":"${workspaceFolder}/search_engine/words_list",
        "WORDS_LIST_SRC_DIR":"${workspaceFolder}/search_engine/words_list/src",
        "WORDS_LIST_INC_DIR":"${workspaceFolder}/search_engine/words_list/inc",
        "TOOLS_DIR":"${workspaceFolder}/search_engine/tools",
        "TOOLS_SRC_DIR":"${workspaceFolder}/search_engine/tools/src",
        "TOOLS_INC_DIR":"${workspaceFolder}/search_engine/tools/inc",
        "USR_FCT_DIR":"${workspaceFolder}/usr_fct",
        "USR_FCT_SRC_DIR":"${workspaceFolder}/usr_fct/src",
        "USR_FCT_INC_DIR":"${workspaceFolder}/usr_fct/inc",
        "TESTS_DIR":"${workspaceFolder}/tests",
        "BUILD_TESTS_DIR":"${workspaceFolder}/build/tests",
        "UNIT_TESTS_DIR":"${workspaceFolder}/tests/UnitTests",
        "INTEGRATION_TESTS_DIR":"${workspaceFolder}/tests/IntegrationTests",
        "BUILD_UNIT_TESTS_DIR":"${workspaceFolder}/build/tests/UnitTests",
        "BUILD_INTEGRATION_TESTS_DIR":"${workspaceFolder}/build/tests/IntegrationTests",
        "VERBOSE": "1",
        "RUN_MODE":"DEBUG"
    }
}